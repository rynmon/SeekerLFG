-- luacheck config for CI (.github/workflows/release.yml). It checks globals only (luacheck --only 11 12):
-- a misspelt game function or a global set by mistake. Add any new game global Seeker uses here.
std = "lua51"
max_line_length = false
exclude_files = { ".github" }

-- Globals Seeker sets (its saved variables, slash command, keybindings, addon compartment),
-- and game tables it adds to.
globals = {
    "BINDING_NAME_SEEKERLFG_SEARCH",
    "BINDING_NAME_SEEKERLFG_TOGGLE",
    "SeekerLFG_BindingSearch",
    "SeekerLFG_BindingToggle",
    "SeekerLFG_OnAddonCompartmentClick",
    "SeekerLFG_OnAddonCompartmentEnter",
    "SeekerLFG_OnAddonCompartmentLeave",
    "SeekerLFGCharDB",
    "SeekerLFGDB",
    "SLASH_SEEKERLFG1",
    "SLASH_SEEKERLFG2",
    "SLASH_SEEKERLFG3",
    "SlashCmdList",
    "StaticPopupDialogs",
    "UISpecialFrames",
}

